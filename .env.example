# ───────── MODO ─────────
# signals = solo avisa por Telegram | paper = simula operaciones | live = opera en BingX
TRADING_MODE=signals

# ───────── BINGX (solo necesarias en live) ─────────
# Crea la API key SIN permiso de retiro.
BINGX_API_KEY=
BINGX_API_SECRET=
# true = cuenta demo de BingX (VST). Recomendado antes de pasar a live.
BINGX_DEMO=false
# BingX suele usar modo Hedge (posiciones LONG/SHORT separadas). Pon false si tu cuenta es One-Way.
HEDGE_MODE=true

# ───────── TELEGRAM ─────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ───────── RIESGO ─────────
LEVERAGE=5
RISK_PER_TRADE_PCT=0.5
MAX_MARGIN_PCT=20
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=6
DAILY_LOSS_LIMIT_PCT=3
PAPER_EQUITY=1000

# ───────── ESCANEO ─────────
SCAN_INTERVAL_SEC=300
MIN_24H_VOLUME_USD=3000000
MIN_SCORE=65
COOLDOWN_MIN=240

# ───────── PERSISTENCIA (en Railway: monta un Volume en /data) ─────────
DATA_DIR=data
